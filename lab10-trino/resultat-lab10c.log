... import os
... import pandas as pd
... import trino
... pd.set_option("display.width", 250); pd.set_option("display.max_columns", 20); pd.set_option("display.max_colwidth", 90)
... 
... CATALOG = "lakehouse"
... 
... conn = trino.dbapi.connect(
...     host=os.environ["TRINO_HOST"],
...     port=int(os.environ["TRINO_PORT"]),
...     user=os.environ["TRINO_USER"],
...     http_scheme="http",
...     catalog=CATALOG,
... )
... 
... def sql(statement):
...     cur = conn.cursor()
...     cur.execute(statement)
...     rows = cur.fetchall()  # the query only completes when its results are fetched
...     columns = [c[0] for c in cur.description] if cur.description else []
...     return pd.DataFrame(rows, columns=columns)
... 
... def input_lines(plan_text):
...     return [l.strip() for l in plan_text.splitlines() if "Input:" in l or "ScanFilter" in l or "TableScan" in l][:8]
... # Lab 10 / lab-3 - star schema
... print(sql("""
...     CREATE TABLE lakehouse.gold.dim_user AS
...     SELECT
...         row_number() OVER (ORDER BY user_id) AS user_key,
...         user_id, username, name, sex, birthdate, city, state, zip_code
...     FROM lakehouse.silver.users
... """))
... print(sql("""
...     CREATE TABLE lakehouse.gold.dim_product AS
...     SELECT row_number() OVER (ORDER BY product) AS product_key, product
...     FROM (SELECT DISTINCT product FROM lakehouse.silver.orders)
... """))
   rows
0    50
